# ── Aurora Notebook configuration ──────────────────────────────────────────
# Every value below has a sensible default — Aurora runs with NO config and NO
# API keys. Copy to `.env` only if you want to change the defaults.
# All variables are prefixed AURORA_.

# ── LLM provider ────────────────────────────────────────────────────────────
# "ollama"    → local models via Ollama (DEFAULT, free, private, offline)
# "openai"    → any OpenAI-compatible endpoint (LM Studio, Groq, OpenRouter, OpenAI…)
# "heuristic" → no model at all; built-in extractive engine (always works)
AURORA_LLM_PROVIDER=ollama

# For ollama: the local server URL. For "openai": the base URL of the endpoint
# (e.g. http://localhost:1234/v1 for LM Studio, https://api.groq.com/openai/v1).
AURORA_LLM_BASE_URL=http://localhost:11434

# Model name as your provider knows it.
#   ollama examples: llama3.1:8b · qwen2.5:7b · gemma2:9b · mistral
#   groq (free tier) examples: llama-3.3-70b-versatile
AURORA_LLM_MODEL=llama3.1:8b

# Only needed for hosted OpenAI-compatible endpoints (leave blank for local).
AURORA_LLM_API_KEY=

# ── Embeddings (semantic search) ────────────────────────────────────────────
# "auto" tries ollama → sentence-transformers → built-in hashing fallback.
AURORA_EMBEDDING_PROVIDER=auto
AURORA_EMBEDDING_MODEL=nomic-embed-text

# ── Podcast text-to-speech (all local) ──────────────────────────────────────
# "auto" → piper if configured, else pyttsx3, else transcript-only.
AURORA_TTS_PROVIDER=auto
# AURORA_PIPER_MODEL_PATH=/path/to/voice.onnx

# ── Retrieval tuning ────────────────────────────────────────────────────────
AURORA_CHUNK_SIZE=1100
AURORA_CHUNK_OVERLAP=150
AURORA_RETRIEVAL_TOP_K=8

# ── Ingestion safety ────────────────────────────────────────────────────────
AURORA_MAX_UPLOAD_MB=50
# SSRF guard: by default Aurora refuses to fetch URLs that resolve to private /
# loopback / link-local addresses. Set true only if you intentionally add
# internal http(s) docs as sources.
AURORA_ALLOW_PRIVATE_URLS=false

# ── Storage / server ────────────────────────────────────────────────────────
# AURORA_DATA_DIR=./backend/data
AURORA_CORS_ORIGINS=*
